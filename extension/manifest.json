{
  "manifest_version": 3,
  "name": "AI Image Detector",
  "version": "0.1.0",
  "description": "Check whether an image appears AI-generated or real.",
  "action": {
    "default_title": "AI Image Detector",
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "permissions": ["contextMenus", "storage"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ]
}
